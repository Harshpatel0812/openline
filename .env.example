# Copy to .env for local development. Never commit real secrets.
# Staging and production secrets live in AWS Secrets Manager only.

NODE_ENV=development
# Deployments must set APP_ENV=staging or APP_ENV=production (see infra/terraform/README.md).
# APP_ENV=development

# Database. Default: on-disk Postgres (PGlite) in .data/ — no Docker needed; the API then runs the
# sending engine itself. With real Postgres (`pnpm services:up`) run apps/worker instead.
DATABASE_URL=pglite://./.data/dev
# DATABASE_URL=postgresql://openline:openline@localhost:5432/openline

# App
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# Web build: production refuses localhost CRM record links (the fake CRM); extra allowed CRM link
# hosts, comma-separated, besides app*.hubspot.com and *.pipedrive.com (SEC-S5).
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_CRM_LINK_HOSTS=

# Email. Locally everything goes to Mailpit (docker compose) at http://localhost:8025.
# MAIL_TRANSPORT=log prints verification/reset links to the API log instead.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025?requireTLS=false
MAIL_FROM=Openline <no-reply@openline.local>
# Website contact-form enquiries are emailed here. Default (dev/test): hello@openline.example.
# Required when APP_ENV=staging or production.
# CONTACT_INBOX=hello@openline.example
# Prospect emails: capture (memory) | sandbox (SMTP_URL locally) | real (production only).
OUTREACH_TRANSPORT=sandbox
# Real sending outside production also needs ALLOW_REAL_SENDING=true. Don't.

# Leave empty locally: fixed development values are used, and refused in staging/production.
SECRETS_KEY=
UNSUBSCRIBE_SECRET=

# Gmail connection (Google Cloud OAuth client, TEST project only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# CRM sync (OL-E8). Outside production only the local fakes or allowlisted sandbox accounts:
#   fake (development/test default): every CRM call goes to tests/e2e/support/fake-crm.mjs
#       (`node tests/e2e/support/fake-crm.mjs`, port 4900); fixed fake client ids are used.
#   sandbox (staging default): real APIs, but only accounts in CRM_SANDBOX_ACCOUNT_IDS may connect
#       (no allowlist = no CRM offered at all).
#   live: production only. Client ids/secrets come from AWS Secrets Manager there, never this file.
# CRM_MODE=fake
# CRM_FAKE_BASE_URL=http://127.0.0.1:4900
# CRM_SANDBOX_ACCOUNT_IDS=
CRM_HUBSPOT_CLIENT_ID=
CRM_HUBSPOT_CLIENT_SECRET=
CRM_PIPEDRIVE_CLIENT_ID=
CRM_PIPEDRIVE_CLIENT_SECRET=
# PKCE is sent only to providers that support it (on for the fakes).
# CRM_HUBSPOT_PKCE=false
# CRM_PIPEDRIVE_PKCE=false
# Polling (ms): HubSpot 10 min, Pipedrive 15 min, idle back-off 30 min.
# CRM_HUBSPOT_INTERVAL_MS=600000
# CRM_PIPEDRIVE_INTERVAL_MS=900000
# CRM_IDLE_INTERVAL_MS=1800000
# CRM_CONNECTS_PER_USER_PER_HOUR=10

# Later sprints
STRIPE_SECRET_KEY=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
SENTRY_DSN=
POSTHOG_KEY=
