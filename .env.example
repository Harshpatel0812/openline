# Copy to .env for local development. Never commit real secrets.
# Production and staging secrets live in AWS Secrets Manager only.

NODE_ENV=development

# Local services (infra/docker/docker-compose.yml)
DATABASE_URL=postgresql://openline:openline@localhost:5432/openline
REDIS_URL=redis://localhost:6379
SMTP_HOST=localhost
SMTP_PORT=1025

# App
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Third parties (fill in locally with TEST keys only)
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
SENTRY_DSN=
POSTHOG_KEY=
