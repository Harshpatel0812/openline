{
  "name": "@openline/ai",
  "version": "0.0.0",
  "private": true,
  "description": "Scout: prompts, tool definitions, guardrails and eval sets.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsc -p tsconfig.build.json && node eval/run.mjs",
    "eval:promises": "tsc -p tsconfig.build.json && node eval/promises.mjs",
    "eval:reality": "tsc -p tsconfig.build.json && node eval/reality.mjs"
  },
  "devDependencies": {
    "@openline/config": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1169.0",
    "@openline/email": "workspace:*",
    "zod": "^4.6.7"
  }
}
